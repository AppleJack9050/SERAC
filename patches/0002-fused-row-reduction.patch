-void __global__ MultiplyDescriptor_Kernel(cudaTextureObject_t texDes1, cudaTextureObject_t texDes2, int* d_result, int num1, int num2, int3* d_temp)
+// Merge two (best, best_index, second_best) triples. `a` wins ties, so the
+// smallest index survives -- the same preference the scalar row scan had.
+__device__ __forceinline__ int3 MergeBest(const int3& a, const int3& b)
+{
+	return a.x < b.x ? make_int3(b.x, b.y, max(a.x, b.z))
+	                 : make_int3(a.x, a.y, max(a.z, b.x));
+}
+
+// Reduce a triple across one warp. Lower lanes hold lower column indices.
+__device__ __forceinline__ int3 WarpReduceBest(int3 r)
+{
+#pragma unroll
+	for(int off = 16; off > 0; off >>= 1)
+	{
+		int3 o;
+		o.x = __shfl_down_sync(0xffffffffu, r.x, off);
+		o.y = __shfl_down_sync(0xffffffffu, r.y, off);
+		o.z = __shfl_down_sync(0xffffffffu, r.z, off);
+		r = MergeBest(r, o);
+	}
+	return r;
+}
